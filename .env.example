# Copie para .env (gitignorado) e preencha. Estes são SEGREDOS de tooling —
# o jogo em si não usa nada daqui; ele só precisa da publishable key que
# já está em engine/config.js (pública por design).

# Personal Access Token do Supabase CLI (crie em:
# https://supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=sbp_...

# Senha do banco Postgres do projeto (definida quando você criou o projeto;
# dá pra resetar em Project Settings → Database → Reset database password)
SUPABASE_DB_PASSWORD=
