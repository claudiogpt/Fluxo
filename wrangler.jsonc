{
	// Config explícita do Cloudflare Workers. Sem este arquivo o `wrangler deploy`
	// cai no autodetect de framework, que tenta reescrever o vite.config.ts em
	// modo não-interativo e falha no build da Cloudflare.
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "peculium-fluxo-financeiro",
	"compatibility_date": "2026-07-30",

	// O Fluxo é 100% estático: React buildado + engine bundlado, e o Supabase é
	// chamado do browser com a publishable key (pública por design, em
	// engine/config.js). Não há Worker script — só assets.
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},

	"observability": {
		"enabled": true
	}
}
