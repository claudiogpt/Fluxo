{"nodes": [{"id": "intro_dc_intro", "label": "Intro (tela de introdu\u00e7\u00e3o / menu principal)", "file_type": "code", "source_file": "Intro.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "intro_dc_renda_passiva", "label": "Renda Passiva", "file_type": "concept", "source_file": "Intro.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "S\u00f3 FIIs, a\u00e7\u00f5es e renda fixa geram renda passiva; cripto n\u00e3o paga aluguel. Super\u00e1-la sobre o custo de vida \u00e9 a condi\u00e7\u00e3o de liberdade."}, {"id": "intro_dc_custo_de_vida", "label": "Custo de Vida", "file_type": "concept", "source_file": "Intro.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drena a conta todo m\u00eas e sobe com a infla\u00e7\u00e3o; se o dinheiro acabar, FALIU."}, {"id": "intro_dc_inflacao", "label": "Infla\u00e7\u00e3o", "file_type": "concept", "source_file": "Intro.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Faz o custo de vida subir m\u00eas a m\u00eas, apertando o caixa ao longo da simula\u00e7\u00e3o."}, {"id": "intro_dc_risco_de_sequencia", "label": "Risco de Sequ\u00eancia", "file_type": "rationale", "source_file": "Intro.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saque fixo = custo de vida (que inflaciona). A ORDEM dos anos bons e ruins decide se o dinheiro dura \u2014 \u00e9 o que cria o risco de sequ\u00eancia no cen\u00e1rio de aposentadoria."}, {"id": "intro_dc_liberdade_financeira", "label": "Liberdade Financeira (condi\u00e7\u00e3o LIVRE)", "file_type": "rationale", "source_file": "Intro.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se a renda passiva superar o custo de vida, o jogador est\u00e1 LIVRE; caso o dinheiro acabe, FALIU. Vit\u00f3ria vem de acumular renda passiva, n\u00e3o de acertar timing."}], "edges": [{"source": "intro_dc_intro", "target": "intro_dc_renda_passiva", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Intro.dc.html", "source_location": null, "weight": 1.0}, {"source": "intro_dc_intro", "target": "intro_dc_custo_de_vida", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Intro.dc.html", "source_location": null, "weight": 1.0}, {"source": "intro_dc_intro", "target": "intro_dc_inflacao", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Intro.dc.html", "source_location": null, "weight": 1.0}, {"source": "intro_dc_intro", "target": "intro_dc_risco_de_sequencia", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Intro.dc.html", "source_location": null, "weight": 1.0}, {"source": "intro_dc_intro", "target": "intro_dc_liberdade_financeira", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Intro.dc.html", "source_location": null, "weight": 1.0}, {"source": "intro_dc_liberdade_financeira", "target": "intro_dc_renda_passiva", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "Intro.dc.html", "source_location": null, "weight": 1.0}, {"source": "intro_dc_liberdade_financeira", "target": "intro_dc_custo_de_vida", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "Intro.dc.html", "source_location": null, "weight": 1.0}, {"source": "intro_dc_custo_de_vida", "target": "intro_dc_inflacao", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "Intro.dc.html", "source_l